# Fake Synology Download Station, for local and CI testing only.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY charon ./charon
COPY fake_ds ./fake_ds
RUN pip install --no-cache-dir .

EXPOSE 5000
CMD ["uvicorn", "fake_ds.app:create_app_from_env", "--factory", "--host", "0.0.0.0", "--port", "5000"]
