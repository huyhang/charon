# Copy to .env next to docker-compose.yml and fill in.

# --- Container / Synology ---
# UID/GID of the Synology user owning the shares (run `id <user>` over SSH).
PUID=1026
PGID=100
# Host IP to bind to: your NAS LAN IP or Tailscale IP. 0.0.0.0 = all interfaces.
CHARON_BIND_IP=0.0.0.0
CHARON_HOST_PORT=8080
CHARON_DATA_DIR=/volume1/docker/charon/data
CHARON_DOWNLOADS_DIR=/volume1/downloads
CHARON_MEDIA_DIR=/volume1/media

# --- Charon ---
# Bootstrap admin key. Leave empty to disable auth entirely.
# When set, every request needs `X-API-Key`: this key, or one issued via POST /api-keys.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CHARON_ADMIN_API_KEY=
CHARON_POLL_INTERVAL_SECONDS=10
# Container directories rules may move files into, comma-separated. Rules can't target
# anything else, and Charon's database directory is always off-limits.
CHARON_RULE_ROOTS=/media
# Comma-separated browser origins allowed to call the API (e.g. a UI dev server).
CHARON_CORS_ORIGINS=
CHARON_LOG_LEVEL=INFO

# --- Download Station ---
# DSM URL as reachable from inside the container (use the NAS LAN IP, not localhost).
CHARON_DS_URL=http://192.168.1.10:5000
# A DSM account allowed to use Download Station. A dedicated account is recommended.
CHARON_DS_USERNAME=charon
CHARON_DS_PASSWORD=
# Shared folder (and optional subfolder) Download Station saves to, as DSM names it.
# It must be the folder mounted at /downloads above.
CHARON_DS_DESTINATION=downloads
# Set to false if CHARON_DS_URL uses https with a self-signed certificate.
CHARON_DS_VERIFY_TLS=true
